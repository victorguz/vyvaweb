---
/**
 * Página de la pauta. Reemplaza a /demo: el anuncio ya no lleva a agendar una
 * llamada, lleva a suscribirse. Va sin menú ni pie de sitio para que no haya
 * más salidas que el pago.
 */
import Landing from '../layouts/Landing.astro';
import Icon from '../components/Icon.astro';
import SelectorPrecio from '../components/marketing/SelectorPrecio.svelte';
import { getPrecio } from '../lib/precio';
import MockWhatsapp from '../components/mock/Whatsapp.astro';
import MockAgenda from '../components/mock/Agenda.astro';
import MockVentas from '../components/mock/Ventas.astro';
import MockCobro from '../components/mock/Cobro.astro';
import MockClientes from '../components/mock/Clientes.astro';

const PRECIO_PLAN = await getPrecio();
const CHECKOUT = `https://app.vyvapos.com/auth/login?intent=pay-plan&plan=${PRECIO_PLAN.id}`;

const dia = [
	{
		hora: 'Toda la mañana',
		title: 'Te escriben por WhatsApp y respondes entre cliente y cliente',
		body: 'Los mensajes llegan a una sola bandeja y quien escribe queda registrado, con su teléfono y su historia. Nadie vuelve a copiar datos a una libreta.',
		componente: 'whatsapp',
	},
	{
		hora: 'Al agendar',
		title: 'La cita entra sola y el aviso sale solo',
		body: 'Desde el chat o desde tu enlace de reservas, la cita cae en la agenda de quien la atiende y el cliente recibe su confirmación y su recordatorio.',
		componente: 'agenda',
	},
	{
		hora: 'Al cobrar',
		title: 'Cobras sin cambiar de aplicación',
		body: 'Servicios y productos en la misma venta, con el medio de pago de cada quien. La venta queda en la historia del cliente.',
		componente: 'cobro',
	},
	{
		hora: 'Al cerrar',
		title: 'El día cuadra solo, venta por venta',
		body: 'Cada cobro queda en el listado con quién atendió, qué se vendió y si quedó pagado o abonado. Los gastos van en la misma lista, así que el total del día sale sin sacar cuentas.',
		componente: 'ventas',
	},
	{
		hora: 'Semanas después',
		title: 'Te avisa quién dejó de volver',
		body: 'Vyva aprende cada cuánto viene cada cliente y arma la lista de los que se pasaron de su ritmo. Desde ahí mismo les escribes.',
		componente: 'clientes',
	},
];

const incluye = [
	'El WhatsApp del negocio, con la historia de cada cliente al lado',
	'Citas, enlace de reservas y avisos automáticos, sin cobro por aviso enviado',
	'Cobro, ventas y cierre del día',
	'Todo tu equipo, sin cobro por persona',
	'Configuración inicial hecha contigo, sin costo aparte',
];

const paraQuienSi = [
	'Negocios que atienden a mucha gente con un equipo pequeño',
	'Los que reciben citas: estética, salud, bienestar, mascotas, servicios a domicilio',
	'Los que reciben pedidos por WhatsApp o por redes',
	'Los que ya no dan abasto respondiendo, agendando y cobrando a la vez',
];

const paraQuienNo = [
	'Si atiendes dos o tres personas al día, todavía no te compensa',
	'Si no tienes tarjeta débito o crédito para el pago mensual',
	'Si necesitas facturación electrónica ante la DIAN desde el primer día',
];
---

<Landing
	title="Empieza hoy con Vyva | Todo tu negocio en un solo lugar"
	description="Vyva reúne el WhatsApp del negocio, las citas, el cobro, las ventas y las cuentas del día. Te suscribes con tu tarjeta y la configuración inicial se hace contigo."
>
	<main>
		<!-- ============ HERO ============ -->
		<section class="relative overflow-hidden">
			<div
				class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_85%_8%,var(--color-brand-100),transparent_60%)]"
			>
			</div>

			<div class="mx-auto max-w-7xl px-5 pt-10 sm:px-8">
				<img src="/brand/vyva_logo_black.svg" alt="Vyva" class="h-7 w-auto" />
			</div>

			<div
				class="mx-auto grid max-w-7xl items-center gap-12 px-5 pt-12 pb-16 sm:px-8 lg:grid-cols-2 lg:gap-10 lg:pt-16 lg:pb-24"
			>
				<div>
					<p
						data-reveal
						class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-sm font-semibold text-brand-700"
					>
						<Icon name="sparkle" size={16} />
						Plan fundador · precio congelado
					</p>

					<h1
						data-reveal
						class="mt-6 text-4xl leading-[1.05] font-extrabold tracking-tight text-ink sm:text-5xl lg:text-[3.4rem]"
					>
						Te llegan muchos clientes
						<span class="text-brand-600">y ya no das abasto</span>
					</h1>

					<p data-reveal class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
						Responder, agendar, anotar el pedido, cobrar y acordarse de todo al
						tiempo. Vyva lo sostiene en un solo lugar: lo que te escriben, las
						citas, el cobro, las ventas y las cuentas del día.
					</p>

					<div data-reveal class="mt-8">
						<a
							href={CHECKOUT}
							data-signup-plan={CHECKOUT}
							class="btn-press inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-7 py-4 text-base font-semibold text-white shadow-lg shadow-brand-600/25"
						>
							Empieza ahora
							<Icon name="arrow-right" size={18} />
						</a>
					</div>

					<p data-reveal class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-500">
						<span class="inline-flex items-center gap-1.5">
							<Icon name="check" size={16} class="text-brand-600" /> Sin instalar nada
						</span>
						<span class="inline-flex items-center gap-1.5">
							<Icon name="check" size={16} class="text-brand-600" /> Configuración incluida
						</span>
						<span class="inline-flex items-center gap-1.5">
							<Icon name="check" size={16} class="text-brand-600" /> Sin permanencia
						</span>
					</p>
				</div>

				<div data-reveal>
					<MockWhatsapp
						pie="Lo que te escriben al WhatsApp del negocio, con la ficha del cliente hecha sola."
					/>
				</div>
			</div>
		</section>

		<!-- ============ EL DÍA ============ -->
		<section class="border-y border-slate-200 bg-slate-50">
			<div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
				<div class="max-w-2xl">
					<h2 data-reveal class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
						Un día cualquiera, con Vyva
					</h2>
					<p data-reveal class="mt-4 text-lg leading-relaxed text-slate-600">
						Estas son las pantallas que vas a usar, no una presentación.
					</p>
				</div>

				<div class="mt-16 flex flex-col gap-16 lg:gap-24">
					{
						dia.map((momento, i) => (
							<div
								data-reveal
								class={`grid items-center gap-8 lg:grid-cols-2 lg:gap-14 ${
									i % 2 === 1 ? 'lg:[&>div:first-child]:order-2' : ''
								}`}
							>
								<div>
									<span class="inline-block rounded-full bg-white px-3 py-1 text-xs font-bold tracking-[0.14em] text-brand-700 uppercase shadow-sm">
										{momento.hora}
									</span>
									<h3 class="mt-4 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
										{momento.title}
									</h3>
									<p class="mt-3 max-w-lg text-base leading-relaxed text-slate-600">
										{momento.body}
									</p>
								</div>
								<div>
									{momento.componente === 'whatsapp' && <MockWhatsapp />}
									{momento.componente === 'agenda' && <MockAgenda />}
									{momento.componente === 'ventas' && <MockVentas />}
									{momento.componente === 'cobro' && <MockCobro />}
									{momento.componente === 'clientes' && <MockClientes />}
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- ============ PRECIO ============ -->
		<section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
			<div class="mx-auto max-w-2xl text-center">
				<h2 data-reveal class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
					Un solo precio, con todo incluido
				</h2>
				<p data-reveal class="mt-4 text-lg leading-relaxed text-slate-600">
					Sin módulos aparte y sin cobro por persona del equipo.
				</p>
			</div>

			<div
				data-reveal
				class="mx-auto mt-12 max-w-lg overflow-hidden rounded-3xl border-2 border-brand-300 bg-white shadow-xl shadow-brand-600/10"
			>
				<div class="bg-brand-600 px-6 py-3 text-center">
					<p class="text-sm font-bold tracking-[0.14em] text-white uppercase">Plan fundador</p>
				</div>

				<div class="px-8 py-10 text-center">
					<SelectorPrecio precio={PRECIO_PLAN} client:load />

					<ul class="mt-8 space-y-3 text-left">
						{
							incluye.map((f) => (
								<li class="flex gap-3">
									<span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-600 text-white">
										<Icon name="check" size={12} />
									</span>
									<span class="text-sm font-medium text-slate-700">{f}</span>
								</li>
							))
						}
					</ul>

					<a
						href={CHECKOUT}
						data-signup-plan={CHECKOUT}
						class="btn-press mt-9 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25"
					>
						Empieza ahora
						<Icon name="arrow-right" size={18} />
					</a>

					<p class="mt-6 flex items-center justify-center gap-2 text-xs text-slate-400">
						<Icon name="lock-key" size={14} />
						Pago con tarjeta débito o crédito Visa o Mastercard
					</p>
				</div>
			</div>

			<p data-reveal class="mx-auto mt-8 max-w-xl text-center text-sm leading-relaxed text-slate-500">
				Después del pago se agenda la configuración inicial: cargamos tus
				servicios, tus precios, tus horarios y tu equipo contigo.
			</p>
		</section>

		<!-- ============ PARA QUIÉN ============ -->
		<section class="border-t border-slate-200 bg-slate-50">
			<div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-24">
				<div class="max-w-2xl">
					<h2 data-reveal class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
						Vyva no es para todo el mundo
					</h2>
					<p data-reveal class="mt-4 text-lg leading-relaxed text-slate-600">
						Preferimos decírtelo aquí y no después de que pagues.
					</p>
				</div>

				<div class="mt-12 grid gap-6 lg:grid-cols-2">
					<div data-reveal class="rounded-2xl border-2 border-brand-200 bg-white p-7">
						<h3 class="text-lg font-bold text-ink">Sí es para ti</h3>
						<ul class="mt-5 space-y-3">
							{
								paraQuienSi.map((u) => (
									<li class="flex gap-3">
										<span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-600 text-white">
											<Icon name="check" size={12} />
										</span>
										<span class="text-sm leading-relaxed font-medium text-slate-700">{u}</span>
									</li>
								))
							}
						</ul>
					</div>

					<div data-reveal class="rounded-2xl border border-slate-200 bg-white p-7">
						<h3 class="text-lg font-bold text-ink">Todavía no es para ti</h3>
						<ul class="mt-5 space-y-3">
							{
								paraQuienNo.map((u) => (
									<li class="flex gap-3">
										<span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-slate-100 text-slate-400">
											<Icon name="x" size={12} />
										</span>
										<span class="text-sm leading-relaxed text-slate-600">{u}</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ CTA FINAL ============ -->
		<section class="px-5 py-20 sm:px-8">
			<div
				class="relative mx-auto max-w-7xl overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 to-brand-800 px-6 py-16 text-center sm:px-12"
			>
				<div
					class="pointer-events-none absolute inset-0 bg-[radial-gradient(40%_50%_at_50%_0%,rgba(255,255,255,0.18),transparent)]"
				>
				</div>
				<h2
					data-reveal
					class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-white sm:text-4xl"
				>
					Empieza hoy y deja de sostenerlo todo en la cabeza
				</h2>
				<p data-reveal class="mx-auto mt-4 max-w-xl text-lg text-brand-100">
					Te suscribes, entras de una y la configuración inicial se hace contigo.
				</p>
				<div data-reveal class="mt-8 flex justify-center">
					<a
						href={CHECKOUT}
						data-signup-plan={CHECKOUT}
						class="btn-press inline-flex items-center justify-center gap-2 rounded-xl bg-white px-8 py-4 text-base font-semibold text-brand-700 shadow-lg"
					>
						Empieza ahora
						<Icon name="arrow-right" size={18} />
					</a>
				</div>
				<p data-reveal class="mt-5 text-sm text-brand-100">
					Precio congelado · Sin permanencia
				</p>
			</div>
		</section>

		<!-- ============ LEGAL ============ -->
		<footer class="border-t border-slate-200 bg-white">
			<div
				class="mx-auto flex max-w-5xl flex-col items-center gap-3 px-5 py-9 text-center text-sm text-slate-500 sm:flex-row sm:justify-between sm:px-8 sm:text-left"
			>
				<p>© {new Date().getFullYear()} VyvaPOS, LLC. Barranquilla, Colombia.</p>
				<div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
					<a href="/privacy" target="_blank" rel="noopener" class="hover:text-ink">Privacidad</a>
					<a href="/terms" target="_blank" rel="noopener" class="hover:text-ink">Términos</a>
				</div>
			</div>
		</footer>
	</main>
</Landing>
