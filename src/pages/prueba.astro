---
/**
 * Landing de la prueba de 1 mes. A ella llegan el link en bio de Víctor
 * (victorguzweb, botón «1 MES GRATIS DE VYVA») y los cierres «Comenta PRUEBA».
 *
 * La prueba es el código promocional PRUEBA de Stripe (cupón «1 mes gratis de
 * Vyva»: 100 % el primer mes, solo el plan Profesional y solo para quien nunca
 * ha pagado). Stripe Checkout lo acepta únicamente en el ciclo mensual
 * (payments-api, allow_promotion_codes), así que esta página nunca lleva al
 * anual. La persona lo escribe en «¿Tienes un código promocional?».
 *
 * Reglas de la campaña: se pide tarjeta (nunca decir «sin tarjeta») y no se
 * habla de lo que pasa con la cuenta al vencer.
 */
import Landing from '../layouts/Landing.astro';
import Icon from '../components/Icon.astro';
import { getPrecio } from '../lib/precio';
import MockWhatsapp from '../components/mock/Whatsapp.astro';
import MockAgenda from '../components/mock/Agenda.astro';
import MockClientes from '../components/mock/Clientes.astro';

const PRECIO_PLAN = await getPrecio();
const CODIGO = 'PRUEBA';
const CHECKOUT = `https://app.vyvapos.com/auth/login?intent=pay-plan&plan=${PRECIO_PLAN.id}&interval=month`;

const pasos = [
	{
		title: 'Crea tu cuenta de negocio',
		body: 'Con tu correo o con Google. Toma un minuto.',
	},
	{
		title: `Al pagar, escribe el código ${CODIGO}`,
		body: 'En la página de pago toca «¿Tienes un código promocional?», escríbelo y el primer mes queda en $0.',
	},
	{
		title: 'Úsalo un mes completo',
		body: `Te pedimos la tarjeta para dejar lista la suscripción, pero este mes no se cobra. Después son ${PRECIO_PLAN.ciclos.mensual.texto} al mes y cancelas cuando quieras.`,
	},
];

const funciones = [
	{
		title: 'El WhatsApp del negocio en un solo lugar',
		body: 'Lo que te escriben llega a una bandeja y cada cliente queda registrado con su historia.',
		componente: 'whatsapp',
	},
	{
		title: 'Las citas se agendan y se recuerdan solas',
		body: 'Cada cita cae en la agenda de quien la atiende y el cliente recibe su confirmación y su recordatorio.',
		componente: 'agenda',
	},
	{
		title: 'Sabes quién dejó de volver',
		body: 'Vyva arma la lista de los clientes que se pasaron de su ritmo, y desde ahí mismo les escribes.',
		componente: 'clientes',
	},
];
---

<Landing
	title="1 mes gratis de Vyva | Prueba todo tu negocio en un solo lugar"
	description={`Prueba Vyva un mes sin costo con el código ${CODIGO}: el WhatsApp del negocio, las citas, el cobro y tus clientes en un solo lugar.`}
>
	<main>
		<!-- ============ HERO ============ -->
		<section class="relative overflow-hidden">
			<div
				class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_85%_8%,var(--color-brand-100),transparent_60%)]"
			>
			</div>

			<div class="mx-auto max-w-7xl px-5 pt-10 sm:px-8">
				<img src="/brand/vyva_logo_black.svg" alt="Vyva" class="h-7 w-auto" />
			</div>

			<div
				class="mx-auto grid max-w-7xl items-center gap-12 px-5 pt-12 pb-16 sm:px-8 lg:grid-cols-2 lg:gap-10 lg:pt-16 lg:pb-24"
			>
				<div>
					<p
						data-reveal
						class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-sm font-semibold text-brand-700"
					>
						<Icon name="sparkle" size={16} />
						Prueba de 1 mes
					</p>

					<h1
						data-reveal
						class="mt-6 text-4xl leading-[1.05] font-extrabold tracking-tight text-ink sm:text-5xl lg:text-[3.4rem]"
					>
						Prueba Vyva un mes
						<span class="text-brand-600">sin pagar nada</span>
					</h1>

					<p data-reveal class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
						Lo que te escriben, las citas, el cobro y tus clientes en un solo
						lugar. Úsalo con tu negocio real durante un mes y decide después.
					</p>

					<div data-reveal class="mt-8 flex flex-col items-start gap-4">
						<a
							href={CHECKOUT}
							class="btn-press inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-7 py-4 text-base font-semibold tracking-wide text-white uppercase shadow-lg shadow-brand-600/25"
						>
							<span>1 mes gratis de <span class="font-black">Vyva</span></span>
							<Icon name="arrow-right" size={18} />
						</a>

						<div class="flex items-center gap-3 rounded-xl border border-dashed border-brand-300 bg-brand-50 px-4 py-2.5">
							<span class="text-sm text-slate-600">Código al pagar:</span>
							<span class="font-mono text-lg font-black tracking-widest text-brand-700">{CODIGO}</span>
							<button
								type="button"
								data-copiar={CODIGO}
								class="rounded-lg bg-white px-3 py-1 text-xs font-semibold text-brand-700 shadow-sm"
							>
								Copiar
							</button>
						</div>
					</div>

					<p data-reveal class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-500">
						<span class="inline-flex items-center gap-1.5">
							<Icon name="check" size={16} class="text-brand-600" /> $0 el primer mes
						</span>
						<span class="inline-flex items-center gap-1.5">
							<Icon name="check" size={16} class="text-brand-600" /> Sin permanencia
						</span>
						<span class="inline-flex items-center gap-1.5">
							<Icon name="check" size={16} class="text-brand-600" /> Configuración incluida
						</span>
					</p>
				</div>

				<div data-reveal>
					<MockWhatsapp
						pie="Lo que te escriben al WhatsApp del negocio, con la ficha del cliente hecha sola."
					/>
				</div>
			</div>
		</section>

		<!-- ============ CÓMO SE ACTIVA ============ -->
		<section class="border-y border-slate-200 bg-slate-50">
			<div class="mx-auto max-w-5xl px-5 py-20 sm:px-8 lg:py-24">
				<h2 data-reveal class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
					Así activas tu mes gratis
				</h2>
				<ol class="mt-12 grid gap-6 lg:grid-cols-3">
					{
						pasos.map((paso, i) => (
							<li data-reveal class="rounded-2xl border border-slate-200 bg-white p-7">
								<span class="grid h-9 w-9 place-items-center rounded-full bg-brand-600 font-bold text-white">
									{i + 1}
								</span>
								<h3 class="mt-5 text-lg font-bold text-ink">{paso.title}</h3>
								<p class="mt-2 text-sm leading-relaxed text-slate-600">{paso.body}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- ============ QUÉ VAS A PROBAR ============ -->
		<section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
			<h2 data-reveal class="max-w-2xl text-3xl font-bold tracking-tight text-ink sm:text-4xl">
				Lo que vas a usar este mes
			</h2>
			<div class="mt-16 flex flex-col gap-16 lg:gap-24">
				{
					funciones.map((f, i) => (
						<div
							data-reveal
							class={`grid items-center gap-8 lg:grid-cols-2 lg:gap-14 ${
								i % 2 === 1 ? 'lg:[&>div:first-child]:order-2' : ''
							}`}
						>
							<div>
								<h3 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">{f.title}</h3>
								<p class="mt-3 max-w-lg text-base leading-relaxed text-slate-600">{f.body}</p>
							</div>
							<div>
								{f.componente === 'whatsapp' && <MockWhatsapp />}
								{f.componente === 'agenda' && <MockAgenda />}
								{f.componente === 'clientes' && <MockClientes />}
							</div>
						</div>
					))
				}
			</div>
		</section>

		<!-- ============ CTA FINAL ============ -->
		<section class="px-5 pb-20 sm:px-8">
			<div
				class="relative mx-auto max-w-7xl overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 to-brand-800 px-6 py-16 text-center sm:px-12"
			>
				<div
					class="pointer-events-none absolute inset-0 bg-[radial-gradient(40%_50%_at_50%_0%,rgba(255,255,255,0.18),transparent)]"
				>
				</div>
				<h2 data-reveal class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-white sm:text-4xl">
					Pruébalo con tu negocio real
				</h2>
				<p data-reveal class="mx-auto mt-4 max-w-xl text-lg text-brand-100">
					Al pagar escribe el código <strong class="font-black text-white">{CODIGO}</strong> y el primer mes queda en $0.
				</p>
				<div data-reveal class="mt-8 flex justify-center">
					<a
						href={CHECKOUT}
						class="btn-press inline-flex items-center justify-center gap-2 rounded-xl bg-white px-8 py-4 text-base font-semibold tracking-wide text-brand-700 uppercase shadow-lg"
					>
						<span>1 mes gratis de <span class="font-black">Vyva</span></span>
						<Icon name="arrow-right" size={18} />
					</a>
				</div>
				<p data-reveal class="mt-5 text-sm text-brand-100">
					Después, {PRECIO_PLAN.ciclos.mensual.texto} al mes · Sin permanencia
				</p>
			</div>
		</section>

		<!-- ============ LEGAL ============ -->
		<footer class="border-t border-slate-200 bg-white">
			<div
				class="mx-auto flex max-w-5xl flex-col items-center gap-3 px-5 py-9 text-center text-sm text-slate-500 sm:flex-row sm:justify-between sm:px-8 sm:text-left"
			>
				<p>© {new Date().getFullYear()} VyvaPOS, LLC. Barranquilla, Colombia.</p>
				<div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
					<a href="/privacy" target="_blank" rel="noopener" class="hover:text-ink">Privacidad</a>
					<a href="/terms" target="_blank" rel="noopener" class="hover:text-ink">Términos</a>
				</div>
			</div>
		</footer>
	</main>

	<script>
		document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((boton) => {
			boton.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(boton.dataset.copiar ?? '');
					boton.textContent = 'Copiado';
					setTimeout(() => (boton.textContent = 'Copiar'), 2000);
				} catch {
					// Sin portapapeles: el código queda a la vista para escribirlo.
				}
			});
		});
	</script>
</Landing>
