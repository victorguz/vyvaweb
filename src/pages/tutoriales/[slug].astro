---
import Landing from '../../layouts/Landing.astro';
import Nav from '../../components/Nav.svelte';
import Footer from '../../components/Footer.astro';
import TutorialPlayer from '../../components/TutorialPlayer.svelte';
import catalogo from '../../lib/tutoriales.json';
import { TUTORIALES_TEXTO } from '../../lib/tutoriales-seo';

export function getStaticPaths() {
	return catalogo.tutoriales.map((t, i) => ({
		params: { slug: t.slug },
		props: {
			tutorial: t,
			grupo: catalogo.grupos.find((g) => g.id === t.grupo),
			anterior: catalogo.tutoriales[i - 1] ?? null,
			siguiente: catalogo.tutoriales[i + 1] ?? null,
		},
	}));
}

const { tutorial, grupo, anterior, siguiente } = Astro.props;

// El texto de búsqueda vive aparte, en tutoriales-seo.ts. Si un tutorial nuevo
// todavía no lo tiene, se cae al título y la descripción del catálogo.
const texto = TUTORIALES_TEXTO[tutorial.slug];
const titulo = texto?.titulo ?? tutorial.titulo;
const descripcion = texto?.descripcion ?? tutorial.descripcion;
---

<Landing
	title={`${titulo} | Vyva`}
	description={descripcion}
>
	<Nav client:load />

	<main>
		<section class="page-hero relative overflow-hidden bg-white">
			<div
				class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_50%_at_50%_0%,var(--color-brand-100),transparent_70%)]"
			>
			</div>
			<div class="mx-auto max-w-3xl px-5 sm:px-8">
				<a href="/tutoriales" class="text-sm font-medium text-brand-600 hover:underline">
					← Todos los tutoriales
				</a>
				<p class="mt-6 text-sm font-semibold uppercase tracking-wide text-brand-600">
					{grupo?.label}
				</p>
				<h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
					{titulo}
				</h1>
				<p class="mt-4 text-lg leading-relaxed text-slate-600">
					{texto?.intro ?? tutorial.descripcion}
				</p>
				<p class="mt-3 text-sm text-slate-500">
					{tutorial.pasos.length} pasos · {tutorial.duracion} min
				</p>
			</div>
		</section>

		<section class="pb-16 sm:pb-20">
			<div class="mx-auto max-w-3xl px-5 sm:px-8">
				<TutorialPlayer client:load tutorial={tutorial} />

				<p class="mt-4 text-sm text-slate-500">
					Toca cualquier paso para saltar a ese punto del video.
				</p>

				{
					texto && (
						<div class="prosa mt-12 border-t border-slate-200 pt-10">
							<h2>Paso a paso</h2>
							<ol>
								{texto.pasos.map((paso) => (
									<li>{paso}</li>
								))}
							</ol>
							{texto.nota && (
								<div class="destacado">
									<p>
										<strong>Ojo con esto:</strong> {texto.nota}
									</p>
								</div>
							)}
						</div>
					)
				}

				<nav class="mt-12 flex flex-col gap-3 border-t border-slate-200 pt-8 sm:flex-row sm:justify-between">
					{anterior ? (
						<a
							href={`/tutoriales/${anterior.slug}`}
							class="btn-press rounded-xl border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700"
						>
							← {anterior.titulo}
						</a>
					) : (
						<span></span>
					)}
					{siguiente && (
						<a
							href={`/tutoriales/${siguiente.slug}`}
							class="btn-press rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white"
						>
							{siguiente.titulo} →
						</a>
					)}
				</nav>
			</div>
		</section>
	</main>

	<Footer />
</Landing>
