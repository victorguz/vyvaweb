---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/Nav.svelte';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import FeatureCard from '../components/marketing/FeatureCard.astro';
import Callout from '../components/marketing/Callout.astro';
import SelectorPrecio from '../components/marketing/SelectorPrecio.svelte';
import { getPrecio } from '../lib/precio';
import Faq from '../components/Faq.astro';
import { faqsPorTema } from '../lib/faqs';
import MockAgenda from '../components/mock/Agenda.astro';
import MockCobro from '../components/mock/Cobro.astro';
import MockPanel from '../components/mock/Panel.astro';

// Las preguntas salen del origen común; ver src/lib/faqs.ts.
const pricingFaqs = faqsPorTema('precio');

// El precio sale del plan de la app; ver src/lib/precio.ts.
const PRECIO_PLAN = await getPrecio();

/**
 * Entrada al pago del plan, y único CTA de la página. La app pide iniciar
 * sesión (o crear la cuenta) y desde ahí lleva al checkout de la suscripción:
 * por eso el enlace apunta al login con el plan en la URL y no directo a
 * `/pay/plan/:id`, que sin sesión no puede preparar el cobro.
 *
 * El ciclo también viaja en la URL: `SelectorPrecio` le añade `interval=year`
 * cuando se elige anual.
 */
const CHECKOUT = `https://app.vyvapos.com/auth/login?intent=pay-plan&plan=${PRECIO_PLAN.id}`;

const incluido = [
	'Todas las funciones, sin módulos que se pagan aparte',
	'El WhatsApp del negocio, con la historia de cada cliente al lado',
	'Chat, avisos de cita y campañas sin que te cobremos por mensaje',
	'Todo tu equipo, sin cobro por persona',
	'Clientes, citas y pedidos sin tope',
	'Configuración inicial hecha contigo',
	'Precio congelado mientras seas cliente',
	'Sin contrato ni permanencia: cancelas cuando quieras',
];

const featureSections = [
	{
		title: 'Lo que te escriben',
		items: [
			{
				icon: 'chat',
				title: 'Una sola bandeja',
				body: 'El WhatsApp del negocio lo atiende tu equipo sin pasarse el celular.',
			},
			{
				icon: 'identification-card',
				title: 'Ficha automática',
				body: 'Quien escribe queda registrado con su teléfono y su conversación.',
			},
			{
				icon: 'users',
				title: 'La historia al lado',
				body: 'Mientras respondes ves qué se le hizo, cuándo vino y qué compró.',
			},
			{
				icon: 'sparkle',
				title: 'Escribirle a una lista',
				body: 'Promociones o recordatorios a las personas que elijas, desde el mismo lugar.',
			},
		],
	},
	{
		title: 'Las citas',
		items: [
			{
				icon: 'calendar-dots',
				title: 'Tu enlace para reservar',
				body: 'Con tus servicios y horarios. Reservan a cualquier hora sin escribirte.',
			},
			{
				icon: 'bell-ringing',
				title: 'Avisos que salen solos',
				body: 'Confirmación y recordatorio por WhatsApp, y el cliente confirma con un toque.',
			},
			{
				icon: 'users-three',
				title: 'La agenda de cada quien',
				body: 'Cada persona ve su día, según su horario y lo que sabe hacer.',
			},
			{
				icon: 'arrows-clockwise',
				title: 'Google Calendar',
				body: 'Las citas quedan también en el calendario que ya usas.',
			},
		],
	},
	{
		title: 'Los pedidos',
		items: [
			{
				icon: 'list',
				title: 'La fila del día',
				body: 'Nuevo, en preparación, listo. Se ve qué falta sin releer el chat.',
			},
			{
				icon: 'device-mobile',
				title: 'Desde el celular',
				body: 'Quien despacha va moviendo el pedido desde donde esté.',
			},
			{
				icon: 'storefront',
				title: 'Tu catálogo',
				body: 'Productos y servicios con sus precios, listos para armar el pedido.',
			},
			{
				icon: 'check',
				title: 'Queda en la historia',
				body: 'Cada pedido se suma al cliente y a las cuentas del día.',
			},
		],
	},
	{
		title: 'El cobro y el cierre del día',
		items: [
			{
				icon: 'storefront',
				title: 'Una sola venta',
				body: 'Servicios y productos juntos, sin cambiar de aplicación.',
			},
			{
				icon: 'lock-key',
				title: 'Varios medios de pago',
				body: 'Efectivo, tarjeta, transferencia o la mezcla que use cada quien.',
			},
			{
				icon: 'list',
				title: 'Cierre del día',
				body: 'Lo que entró, por medio de pago, sin cuadrar de memoria.',
			},
			{
				icon: 'chart-line',
				title: 'Gastos también',
				body: 'Lo que sale del negocio queda registrado junto a lo que entra.',
			},
		],
	},
	{
		title: 'Que vuelvan',
		items: [
			{
				icon: 'clock',
				title: 'Cada cuánto viene cada uno',
				body: 'Vyva aprende el ritmo de cada cliente sin que nadie lo apunte.',
			},
			{
				icon: 'users',
				title: 'Los que se pasaron',
				body: 'La lista de quienes llevan más tiempo del suyo sin volver.',
			},
			{
				icon: 'chat',
				title: 'Escribirles desde ahí',
				body: 'Del listado al WhatsApp, sin buscar el número en ningún lado.',
			},
			{
				icon: 'sparkle',
				title: 'Los que más valen',
				body: 'Quiénes vienen seguido y gastan por encima del promedio.',
			},
		],
	},
	{
		title: 'El equipo y las cuentas',
		items: [
			{
				icon: 'identification-card',
				title: 'Cada quien con lo suyo',
				body: 'Horarios, servicios y permisos por persona.',
			},
			{
				icon: 'chart-line',
				title: 'Cuánto produce cada uno',
				body: 'Citas atendidas y facturado por persona, sin preguntarlo.',
			},
			{
				icon: 'chart-line',
				title: 'Cómo va el mes',
				body: 'Facturado, clientes atendidos, nuevos y los que vuelven.',
			},
			{
				icon: 'list',
				title: 'Reportes para exportar',
				body: 'Por día, semana, mes o el rango que necesites.',
			},
		],
	},
];

const useCases = [
	{ icon: 'sparkle', title: 'Belleza y estética', body: 'Salones, barberías, uñas y centros de estética con varias personas atendiendo.' },
	{ icon: 'users', title: 'Salud y bienestar', body: 'Consultorios, terapias, spas y masajes con agenda por profesional.' },
	{ icon: 'users-three', title: 'Fitness y entrenamiento', body: 'Entrenadores y estudios con sesiones y clientes recurrentes.' },
	{ icon: 'check', title: 'Mascotas', body: 'Peluquería canina, veterinarias y guarderías con citas y recordatorios.' },
	{ icon: 'storefront', title: 'Comida por encargo', body: 'Pastelerías, catering y cocinas ocultas con pedidos por WhatsApp.' },
	{ icon: 'device-mobile', title: 'Venta por redes', body: 'Tiendas que reciben pedidos por Instagram o WhatsApp y despachan cada día.' },
];
---

<Landing
	title="Precio | Vyva"
	description="Un solo plan de Vyva, con precio visible y todo incluido: el WhatsApp del negocio, citas, pedidos, cobro, clientes y las cuentas del día."
>
	<Nav checkout={CHECKOUT} client:load />

	<main>
		<!-- ============ HERO CON PRECIO ============ -->
		<section class="page-hero relative overflow-hidden bg-white">
			<div
				class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_50%_at_50%_0%,var(--color-brand-100),transparent_70%)]"
			>
			</div>
			<div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
				<h1 data-reveal class="text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
					Un solo precio, y está aquí
				</h1>
				<p data-reveal class="mt-5 text-lg leading-relaxed text-slate-600">
					Sin cotización, sin «depende de tu negocio», sin llamada para saber
					cuánto cuesta.
				</p>
			</div>

			<div
				data-reveal
				class="mx-auto mt-12 max-w-lg overflow-hidden rounded-3xl border-2 border-brand-300 bg-white shadow-xl shadow-brand-600/10"
			>
				<div class="bg-brand-600 px-6 py-3 text-center">
					<p class="text-sm font-bold tracking-[0.14em] text-white uppercase">
						Plan fundador · precio congelado
					</p>
				</div>

				<div class="px-8 py-10 text-center">
					<SelectorPrecio precio={PRECIO_PLAN} client:load />

					<ul class="mt-8 space-y-3 text-left">
						{
							incluido.map((f) => (
								<li class="flex gap-3">
									<span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-600 text-white">
										<Icon name="check" size={12} />
									</span>
									<span class="text-sm font-medium text-slate-700">{f}</span>
								</li>
							))
						}
					</ul>

					<a
						href={CHECKOUT}
						data-signup-plan={CHECKOUT}
						class="btn-press mt-9 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25"
					>
						Empieza ahora
						<Icon name="arrow-right" size={18} />
					</a>

					<p class="mt-6 flex items-center justify-center gap-2 text-xs text-slate-400">
						<Icon name="lock-key" size={14} />
						Pago con tarjeta débito o crédito Visa o Mastercard
					</p>
				</div>
			</div>
		</section>

		<!-- ============ ASÍ SE VE ============ -->
		<section class="border-t border-slate-100 py-16 sm:py-20">
			<div class="mx-auto max-w-7xl px-5 sm:px-8">
				<h2 data-reveal class="section-heading text-center">Así se ve por dentro</h2>
				<p data-reveal class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
					Las mismas pantallas que vas a usar el día que entres.
				</p>
				<div class="mt-12 grid gap-8 lg:grid-cols-3">
					<div data-reveal><MockAgenda pie="Las citas del día, por persona." /></div>
					<div data-reveal><MockCobro pie="El cobro, con servicios y productos juntos." /></div>
					<div data-reveal><MockPanel pie="Cómo va el mes, ya sumado." /></div>
				</div>
			</div>
		</section>

		{
			featureSections.map((section) => (
				<section class="border-t border-slate-100 bg-slate-50/50 py-16 sm:py-20">
					<div class="mx-auto max-w-7xl px-5 sm:px-8">
						<h2 data-reveal class="section-heading">{section.title}</h2>
						<div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
							{section.items.map((item) => (
								<div data-reveal>
									<FeatureCard icon={item.icon} title={item.title} body={item.body} />
								</div>
							))}
						</div>
					</div>
				</section>
			))
		}

		<section class="py-16 sm:py-20">
			<div class="mx-auto max-w-7xl px-5 sm:px-8">
				<h2 data-reveal class="section-heading text-center">Para qué negocios funciona</h2>
				<p data-reveal class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
					Negocios que atienden a mucha gente con un equipo pequeño, reciban
					citas o reciban pedidos.
				</p>
				<div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
					{
						useCases.map((item) => (
							<div data-reveal>
								<FeatureCard icon={item.icon} title={item.title} body={item.body} />
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="border-t border-slate-100 bg-white py-16 sm:py-20">
			<div class="mx-auto max-w-3xl px-5 sm:px-8">
				<Faq items={pricingFaqs} titulo="Preguntas sobre el precio" schema={false} />

				<div data-reveal class="mt-8">
					<Callout variant="note" title="Sin costos ocultos">
						El precio incluye todas las funcionalidades de la plataforma. Sin tarifas de
						configuración ni de cancelación.
					</Callout>
				</div>
			</div>
		</section>

		<section class="px-5 pb-24 sm:px-8">
			<div
				class="relative mx-auto max-w-7xl overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 to-brand-800 px-6 py-16 text-center sm:px-12"
			>
				<h2 data-reveal class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-white">
					Lo activas hoy y empiezas a usarlo
				</h2>
				<p data-reveal class="mx-auto mt-4 max-w-xl text-lg text-brand-100">
					Te suscribes con tu tarjeta, entras de una y la configuración inicial
					se hace contigo.
				</p>
				<div data-reveal class="mt-8 flex justify-center">
					<a
						href={CHECKOUT}
						data-signup-plan={CHECKOUT}
						class="btn-press inline-flex items-center justify-center gap-2 rounded-xl bg-white px-7 py-3.5 font-semibold text-brand-700"
					>
						Empieza ahora
						<Icon name="arrow-right" size={18} />
					</a>
				</div>
				<p data-reveal class="mt-6 text-sm text-brand-200">
					Precio congelado · Sin permanencia · Configuración incluida
				</p>
			</div>
		</section>
	</main>

	<Footer />
</Landing>
