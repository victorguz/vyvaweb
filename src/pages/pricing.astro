---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/Nav.svelte';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import FeatureCard from '../components/marketing/FeatureCard.astro';
import Callout from '../components/marketing/Callout.astro';
import SelectorPrecio from '../components/marketing/SelectorPrecio.svelte';
import { getPrecio } from '../lib/precio';
import Faq from '../components/Faq.astro';
import { faqsPorTema } from '../lib/faqs';

// CTA principal: la llamada. CTA secundario: el checkout self-serve.
// Se invierte cuando haya ~10 clientes pagando y el precio esté validado.
const CALL = 'https://calendar.app.google/TAJNgrzZdqu8s8Rk9';
const SIGNUP = 'https://app.vyvapos.com/plans/essential';

// Las preguntas salen del origen común; ver src/lib/faqs.ts.
const pricingFaqs = faqsPorTema('precio');

// El precio sale del plan de la app; ver src/lib/precio.ts.
const PRECIO_PLAN = await getPrecio();
const { precio: PRECIO } = PRECIO_PLAN;

const incluido = [
	'Todas las funciones, sin módulos que se pagan aparte',
	'Chat de WhatsApp con tus clientas, dentro del sistema',
	'Chat, recordatorios y campañas de WhatsApp sin que te cobremos por mensaje',
	'Usuarios, clientas y citas ilimitados',
	'Configuración inicial hecha contigo en una llamada',
	'Precio congelado mientras seas cliente',
	'Sin contrato ni permanencia: cancelas cuando quieras',
	'Soporte por WhatsApp: te responde una persona',
];

const featureSections = [
	{
		title: 'Agendamiento y citas',
		items: [
			{ icon: 'identification-card', title: 'Página de reservas', body: 'Link único con tu marca para que tus clientas reserven 24/7.' },
			{ icon: 'arrows-clockwise', title: 'Google Calendar', body: 'Sincronización automática de todas tus citas.' },
			{ icon: 'clock', title: 'Horarios flexibles', body: 'Disponibilidad por día, empleado y servicio.' },
			{ icon: 'bell-ringing', title: 'Recordatorios', body: 'Avisos automáticos para reducir las sillas vacías.' },
			{ icon: 'users-three', title: 'Asignación de equipo', body: 'Citas según especialidad y disponibilidad.' },
			{ icon: 'calendar-dots', title: 'Vista calendario', body: 'Timeline interactivo de todas tus citas.' },
		],
	},
	{
		title: 'Gestión de clientas',
		items: [
			{ icon: 'users', title: 'Base de datos', body: 'Contacto, preferencias y notas de cada clienta.' },
			{ icon: 'clock', title: 'Historial de citas', body: 'Servicios tomados y última visita.' },
			{ icon: 'check', title: 'Historial de compras', body: 'Valor de la clienta y productos preferidos.' },
			{ icon: 'chart-line', title: 'Estadísticas', body: 'Clientas nuevas, recurrentes y ticket promedio.' },
		],
	},
	{
		title: 'WhatsApp y CRM',
		items: [
			{ icon: 'chat', title: 'Chat integrado', body: 'Todas las conversaciones en una bandeja, con la ficha de la clienta al lado.' },
			{ icon: 'bell-ringing', title: 'Recordatorios incluidos', body: 'Aviso automático antes de cada cita, sin que se cobre por aviso enviado.' },
			{ icon: 'sparkle', title: 'Campañas', body: 'Promociones y reactivación a la lista de clientas que elijas.' },
			{ icon: 'users', title: 'Segmentación', body: 'Filtra por servicio tomado, última visita o ticket para escribirle a quien toca.' },
		],
	},
	{
		title: 'Punto de venta',
		items: [
			{ icon: 'storefront', title: 'Cobros', body: 'Cobra servicios y productos de forma segura.' },
			{ icon: 'list', title: 'Carrito integrado', body: 'Combina tratamientos y productos en una venta.' },
			{ icon: 'list', title: 'Órdenes de venta', body: 'Órdenes y cierre de caja centralizados.' },
			{ icon: 'lock-key', title: 'Múltiples métodos', body: 'Efectivo, tarjetas, transferencias y más.' },
		],
	},
	{
		title: 'Dashboard y reportes',
		items: [
			{ icon: 'chart-line', title: 'KPIs en tiempo real', body: 'Ventas del día, clientas nuevas y ticket promedio.' },
			{ icon: 'list', title: 'Reportes de ventas', body: 'Por día, semana, mes o rango personalizado.' },
			{ icon: 'sparkle', title: 'Por método de pago', body: 'Ingresos desglosados por canal.' },
			{ icon: 'chart-line', title: 'Gráficos', body: 'Entiende tu negocio de un vistazo.' },
		],
	},
	{
		title: 'Gestión de equipo',
		items: [
			{ icon: 'identification-card', title: 'Perfiles', body: 'Fotos, especialidades y horarios por empleado.' },
			{ icon: 'clock', title: 'Asignación', body: 'Distribución equitativa de citas.' },
			{ icon: 'lock-key', title: 'Roles y permisos', body: 'Control de acceso según el rol.' },
			{ icon: 'chart-line', title: 'Desempeño', body: 'Citas atendidas y ventas por especialista.' },
		],
	},
];

const useCases = [
	{ icon: 'sparkle', title: 'Salones de belleza', body: 'Cortes, tintes y peinados con estilistas por especialidad.' },
	{ icon: 'users', title: 'Estéticas faciales', body: 'Tratamientos, historial de clientas y venta de productos.' },
	{ icon: 'sparkle', title: 'Spas y bienestar', body: 'Múltiples salas, terapeutas y tratamientos coordinados.' },
	{ icon: 'identification-card', title: 'Clínicas estéticas', body: 'Consultas, procedimientos y seguimiento.' },
	{ icon: 'check', title: 'Barberías', body: 'Turnos, clientes recurrentes y servicios de barba.' },
	{ icon: 'users-three', title: 'Centros de masajes', body: 'Tipos de masaje y terapeutas en una sola agenda.' },
];

const comparativa = [
	{
		icon: 'users-three',
		title: 'Usuarios ilimitados',
		body: 'Fresha cobra por cada persona del equipo. Nosotros no. Con cinco especialistas, su cuenta ya te cuesta más que la nuestra.',
	},
	{
		icon: 'storefront',
		title: 'No es solo la agenda',
		body: 'Punto de venta, inventario, clientas y reportes van incluidos. No pagas aparte un software para cobrar.',
	},
	{
		icon: 'chat',
		title: 'Los mensajes no se pagan aparte',
		body: 'En otras plataformas cada recordatorio se cobra por mensaje. Aquí el chat de WhatsApp y los recordatorios van incluidos, y las campañas van dentro del plan.',
	},
	{
		icon: 'check',
		title: 'Cero comisión por clienta nueva',
		body: 'Fresha se queda con un porcentaje de las clientas que llegan por su marketplace. Aquí tu clientela es tuya, completa.',
	},
	{
		icon: 'device-mobile',
		title: 'Te contesta el fundador',
		body: 'No hay mesa de ayuda ni tiquetes. Escribes por WhatsApp y te contesto yo, y lo que pidas entra al desarrollo.',
	},
];

const tablaEquipo = [
	{ personas: '1 persona', vyva: PRECIO, fresha: '$24.000' },
	{ personas: '3 personas', vyva: PRECIO, fresha: '$56.400' },
	{ personas: '5 personas', vyva: PRECIO, fresha: '$88.800' },
	{ personas: '7 personas', vyva: PRECIO, fresha: '$121.200' },
];

---

<Landing
	title="Precio | Vyva"
	description="Un solo plan de Vyva, con precio visible: agenda online, chat de WhatsApp, campañas, clientas, punto de venta y reportes para estéticas, spas, clínicas estéticas y barberías."
>
	<Nav client:load />

	<main>
		<!-- ============ HERO CON PRECIO ============ -->
		<section class="page-hero relative overflow-hidden bg-white">
			<div
				class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_50%_at_50%_0%,var(--color-brand-100),transparent_70%)]"
			>
			</div>
			<div class="mx-auto max-w-3xl px-5 text-center sm:px-8">
				<h1 data-reveal class="text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
					Un solo precio, y está aquí
				</h1>
				<p data-reveal class="mt-5 text-lg leading-relaxed text-slate-600">
					Sin cotización, sin "depende de tu negocio", sin llamada para saber
					cuánto cuesta.
				</p>
			</div>

			<div
				data-reveal
				class="mx-auto mt-12 max-w-lg overflow-hidden rounded-3xl border-2 border-brand-300 bg-white shadow-xl shadow-brand-600/10"
			>
				<div class="bg-brand-600 px-6 py-3 text-center">
					<p class="text-sm font-bold uppercase tracking-[0.14em] text-white">
						Plan fundador · precio congelado
					</p>
				</div>

				<div class="px-8 py-10 text-center">
					<SelectorPrecio precio={PRECIO_PLAN} client:load />

					<ul class="mt-8 space-y-3 text-left">
						{
							incluido.map((f) => (
								<li class="flex gap-3">
									<span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-600 text-white">
										<Icon name="check" size={12} />
									</span>
									<span class="text-sm font-medium text-slate-700">{f}</span>
								</li>
							))
						}
					</ul>

					<a
						href={CALL}
						class="btn-press mt-9 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25"
					>
						Tomar el plan fundador
						<Icon name="arrow-right" size={18} />
					</a>
					<a
						href={SIGNUP}
						data-signup-plan={SIGNUP}
						class="mt-3 inline-block text-sm font-semibold text-slate-500 underline underline-offset-4 hover:text-slate-700"
					>
						o crea tu cuenta sin hablar con nadie
					</a>

					<p class="mt-6 flex items-center justify-center gap-2 text-xs text-slate-400">
						<Icon name="lock-key" size={14} />
						Pago con tarjeta débito o crédito Visa o Mastercard
					</p>
				</div>
			</div>
		</section>


		<!-- ============ POR QUÉ NO SOMOS LOS MÁS BARATOS ============ -->
		<section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
			<div class="max-w-2xl">
				<h2 data-reveal class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
					No somos los más baratos del mercado, y hay razones
				</h2>
				<p data-reveal class="mt-4 text-lg leading-relaxed text-slate-600">
					Hay software de agenda más barato que este. Antes de compararlo por la
					mensualidad sola, mira lo que estás comparando.
				</p>
			</div>

			<div class="mt-12 grid gap-6 sm:grid-cols-2">
				{
					comparativa.map((c) => (
						<article
							data-reveal
							class="rounded-2xl border border-slate-200 bg-white p-6 transition-colors duration-300 hover:border-brand-300"
						>
							<span class="grid h-11 w-11 place-items-center rounded-xl bg-brand-50 text-brand-700">
								<Icon name={c.icon as any} size={24} />
							</span>
							<h3 class="mt-5 text-lg font-bold text-ink">{c.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-slate-600">{c.body}</p>
						</article>
					))
				}
			</div>

			<div data-reveal class="mt-10 overflow-hidden rounded-2xl border border-slate-200 bg-white">
				<div class="border-b border-slate-200 bg-slate-50 px-6 py-4">
					<p class="font-bold text-ink">Lo que pagas al mes según el tamaño de tu equipo</p>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full min-w-[420px] text-sm">
						<thead>
							<tr class="border-b border-slate-200 text-left text-slate-500">
								<th class="px-6 py-3 font-semibold">Tu equipo</th>
								<th class="px-6 py-3 font-semibold text-brand-700">Vyva</th>
								<th class="px-6 py-3 font-semibold">Cobro por persona</th>
							</tr>
						</thead>
						<tbody>
							{
								tablaEquipo.map((f) => (
									<tr class="border-b border-slate-100 last:border-0">
										<td class="px-6 py-3.5 font-medium text-slate-700">{f.personas}</td>
										<td class="px-6 py-3.5 font-bold text-brand-700">{f.vyva}</td>
										<td class="px-6 py-3.5 text-slate-600">{f.fresha}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
				<p class="px-6 py-4 text-xs leading-relaxed text-slate-400">
					Cálculo con tarifas públicas de la competencia a agosto de 2026, sin
					contar comisiones por transacción ni por clienta nueva. Verifica los
					valores antes de tomar una decisión.
				</p>
			</div>
		</section>

		{
			featureSections.map((section) => (
				<section class="border-t border-slate-100 bg-slate-50/50 py-16 sm:py-20">
					<div class="mx-auto max-w-7xl px-5 sm:px-8">
						<h2 data-reveal class="section-heading">{section.title}</h2>
						<div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
							{section.items.map((item) => (
								<div data-reveal>
									<FeatureCard icon={item.icon} title={item.title} body={item.body} />
								</div>
							))}
						</div>
					</div>
				</section>
			))
		}

		<section class="py-16 sm:py-20">
			<div class="mx-auto max-w-7xl px-5 sm:px-8">
				<h2 data-reveal class="section-heading text-center">Diseñado para tu tipo de negocio</h2>
				<p data-reveal class="mx-auto mt-3 max-w-2xl text-center text-slate-600">
					Vyva se adapta a salones, estéticas, spas, barberías y centros de bienestar.
				</p>
				<div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
					{
						useCases.map((item) => (
							<div data-reveal>
								<FeatureCard icon={item.icon} title={item.title} body={item.body} />
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="border-t border-slate-100 bg-white py-16 sm:py-20">
			<div class="mx-auto max-w-3xl px-5 sm:px-8">
				<Faq items={pricingFaqs} titulo="Preguntas sobre el precio" schema={false} />

				<div data-reveal class="mt-8">
					<Callout variant="note" title="Sin costos ocultos">
						El precio incluye todas las funcionalidades de la plataforma. Sin tarifas de
						configuración ni de cancelación.
					</Callout>
				</div>
			</div>
		</section>

		<section class="px-5 pb-24 sm:px-8">
			<div
				class="relative mx-auto max-w-7xl overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 to-brand-800 px-6 py-16 text-center sm:px-12"
			>
				<h2 data-reveal class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-white">
					Quedan cupos del plan fundador
				</h2>
				<p data-reveal class="mx-auto mt-4 max-w-xl text-lg text-brand-100">
					Quince minutos, sin discurso de ventas. Te muestro la plataforma con un
					negocio real funcionando y me dices si te sirve.
				</p>
				<div data-reveal class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
					<a
						href={CALL}
						class="btn-press inline-flex items-center justify-center gap-2 rounded-xl bg-white px-7 py-3.5 font-semibold text-brand-700"
					>
						Agenda una demo
						<Icon name="arrow-right" size={18} />
					</a>
					<a
						href={SIGNUP}
						class="btn-press inline-flex items-center justify-center rounded-xl border border-white/40 px-7 py-3.5 font-semibold text-white hover:bg-white/10"
					>
						Crear mi cuenta
					</a>
				</div>
				<p data-reveal class="mt-6 text-sm text-brand-200">
					Precio congelado · Sin permanencia · Configuración incluida
				</p>
			</div>
		</section>
	</main>

	<Footer />
</Landing>
