---
import { getCollection } from 'astro:content';
import Landing from '../../layouts/Landing.astro';
import Nav from '../../components/Nav.svelte';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import catalogo from '../../lib/tutoriales.json';
import { TUTORIALES_TEXTO } from '../../lib/tutoriales-seo';

const DEMO = 'https://calendar.app.google/TAJNgrzZdqu8s8Rk9';

// Primero lo que busca alguien que ya está evaluando un sistema; después el
// contenido que envejece bien y atrae a quien todavía no lo busca.
const posts = await getCollection('blog');
const porOrden = (a: (typeof posts)[number], b: (typeof posts)[number]) =>
	a.data.orden - b.data.orden;

// Los tutoriales también son búsqueda activa: alguien busca "cómo agendar una
// cita en Vyva". Viven en /tutoriales porque llevan video, y se listan aquí.
const tutoriales = catalogo.tutoriales
	.filter((t) => TUTORIALES_TEXTO[t.slug])
	.map((t) => ({
		href: `/tutoriales/${t.slug}`,
		title: TUTORIALES_TEXTO[t.slug].titulo,
		description: TUTORIALES_TEXTO[t.slug].descripcion,
	}));

const secciones = [
	{
		id: 'busqueda',
		titulo: 'Si estás evaluando un sistema',
		bajada:
			'Lo que conviene revisar antes de decidir: qué mirar, cuánto cuesta de verdad y cómo se hace el cambio sin frenar el negocio.',
		items: [
			...posts
				.filter((p) => p.data.intencion === 'busqueda')
				.sort(porOrden)
				.map((p) => ({
					href: `/blog/${p.id}`,
					title: p.data.title,
					description: p.data.description,
				})),
			{
				href: '/blog/preguntas-frecuentes',
				title: 'Preguntas frecuentes sobre Vyva',
				description:
					'Precio, permanencia, mensajes de WhatsApp, migración de la libreta, soporte y datos: lo que más se pregunta antes de contratar.',
			},
		],
	},
	{
		id: 'como-se-usa',
		titulo: 'Cómo se usa Vyva',
		bajada:
			'Guías cortas con video y paso a paso, para resolver algo concreto sin tener que preguntar.',
		items: tutoriales,
	},
	{
		id: 'gestion',
		titulo: 'Para el día a día del negocio',
		bajada:
			'Retención, números y equipo. Contenido que sirve tengas o no tengas un sistema.',
		items: posts
			.filter((p) => p.data.intencion === 'evergreen')
			.sort(porOrden)
			.map((p) => ({
				href: `/blog/${p.id}`,
				title: p.data.title,
				description: p.data.description,
			})),
	},
];
---

<Landing
	title="Blog de Vyva | Gestión, retención y agenda para negocios de belleza"
	description="Artículos sobre cómo elegir un sistema de agenda, cuánto cuesta de verdad, y cómo retener a las clientas de un negocio de belleza con equipo."
>
	<Nav client:load />

	<main>
		<section class="page-hero relative overflow-hidden bg-white">
			<div
				class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50%_50%_at_50%_0%,var(--color-brand-100),transparent_70%)]"
			>
			</div>
			<div class="mx-auto max-w-3xl px-5 sm:px-8">
				<h1 data-reveal class="text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
					Blog
				</h1>
				<p data-reveal class="mt-5 text-lg leading-relaxed text-slate-600">
					Cómo elegir un sistema para tu negocio de belleza, cuánto cuesta de verdad y
					qué hacer para que tus clientas vuelvan. Escrito para negocios que ya tienen
					equipo.
				</p>
			</div>
		</section>

		{
			secciones.map((seccion) => (
				<section id={seccion.id} class="scroll-mt-24 pb-16 sm:pb-20">
					<div class="mx-auto max-w-5xl px-5 sm:px-8">
						<h2 data-reveal class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
							{seccion.titulo}
						</h2>
						<p data-reveal class="mt-3 max-w-2xl text-slate-600">{seccion.bajada}</p>

						<div class="mt-8 grid gap-5 sm:grid-cols-2">
							{seccion.items.map((post) => (
								<article data-reveal>
									<a
										href={post.href}
										class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-7 transition-colors duration-200 hover:border-brand-300"
									>
										<h3 class="text-lg font-bold leading-snug text-ink group-hover:text-brand-700">
											{post.title}
										</h3>
										<p class="mt-3 flex-grow text-sm leading-relaxed text-slate-600">
											{post.description}
										</p>
										<span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-700">
											Leer
											<Icon name="arrow-right" size={16} />
										</span>
									</a>
								</article>
							))}
						</div>
					</div>
				</section>
			))
		}

		<section class="px-5 pb-24 sm:px-8">
			<div
				class="mx-auto max-w-5xl rounded-3xl bg-gradient-to-br from-brand-600 to-brand-800 px-6 py-14 text-center sm:px-12"
			>
				<h2 data-reveal class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
					¿Quieres verlo funcionando?
				</h2>
				<p data-reveal class="mx-auto mt-3 max-w-2xl text-brand-100">
					En quince minutos ves Vyva con los datos de un negocio real, y sabes qué hace
					falta para que el tuyo llegue ahí.
				</p>
				<div data-reveal class="mt-7">
					<a
						href={DEMO}
						class="btn-press inline-flex items-center justify-center gap-2 rounded-xl bg-white px-7 py-3.5 font-semibold text-brand-700"
					>
						Agenda una demo
						<Icon name="arrow-right" size={18} />
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Landing>
