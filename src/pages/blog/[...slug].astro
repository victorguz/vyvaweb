---
import { getCollection, render } from 'astro:content';
import Landing from '../../layouts/Landing.astro';
import Nav from '../../components/Nav.svelte';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const DEMO = 'https://calendar.app.google/TAJNgrzZdqu8s8Rk9';

const fecha = post.data.fecha.toLocaleDateString('es-CO', {
	year: 'numeric',
	month: 'long',
});
---

<Landing title={`${post.data.title} | Vyva`} description={post.data.description}>
	<Nav client:load />

	<main>
		<section class="page-hero">
			<div class="mx-auto max-w-3xl px-5 sm:px-8">
				<a
					href="/blog"
					class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700"
				>
					<span aria-hidden="true">&larr;</span> Blog
				</a>
				<h1 class="mt-5 text-4xl font-extrabold leading-tight tracking-tight text-ink sm:text-5xl">
					{post.data.title}
				</h1>
				<p class="mt-4 text-sm font-medium text-slate-500">{fecha}</p>
			</div>
		</section>

		<article class="prosa mx-auto max-w-3xl px-5 pb-16 sm:px-8">
			<Content />
		</article>

		<section class="px-5 pb-24 sm:px-8">
			<div
				class="mx-auto max-w-3xl rounded-3xl border border-brand-200 bg-brand-50 px-7 py-10 text-center sm:px-10"
			>
				<h2 class="text-xl font-bold tracking-tight text-ink sm:text-2xl">
					Vyva te dice qué clientas están a punto de no volver
				</h2>
				<p class="mx-auto mt-3 max-w-xl text-slate-600">
					Y te deja escribirles por WhatsApp desde la misma pantalla. Se ve en quince
					minutos, con los datos de un negocio real.
				</p>
				<div class="mt-7">
					<a
						href={DEMO}
						class="btn-press inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-7 py-3.5 font-semibold text-white"
					>
						Agenda una demo
						<Icon name="arrow-right" size={18} />
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Landing>
