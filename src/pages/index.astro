---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/Nav.svelte';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { faqsPorTema } from '../lib/faqs';
import SelectorPrecio from '../components/marketing/SelectorPrecio.svelte';
import { getPrecio } from '../lib/precio';
import MockWhatsapp from '../components/mock/Whatsapp.astro';
import MockAgenda from '../components/mock/Agenda.astro';
import MockVentas from '../components/mock/Ventas.astro';
import MockRecordatorio from '../components/mock/Recordatorio.astro';
import MockCobro from '../components/mock/Cobro.astro';
import MockClientes from '../components/mock/Clientes.astro';
import MockPanel from '../components/mock/Panel.astro';

// Las preguntas salen del origen común; ver src/lib/faqs.ts.
// En la home van las ocho primeras; el listado completo vive en el blog.
const faqs = faqsPorTema('general', 'precio', 'empezar', 'whatsapp').slice(0, 8);

// El precio sale del plan de la app; ver src/lib/precio.ts.
const PRECIO_PLAN = await getPrecio();

// Único CTA del sitio: suscribirse. Entra al login (o registro) de la app y de
// ahí al pago del plan. `SelectorPrecio` le añade `interval=year`.
const CHECKOUT = `https://app.vyvapos.com/auth/login?intent=pay-plan&plan=${PRECIO_PLAN.id}`;

const antes = [
	'Los pedidos y las citas se pierden entre mil chats sin leer',
	'Apuntas en la libreta, en notas del celular y en la cabeza',
	'Te enteras de que no vino cuando no llegó',
	'Cada quien lleva sus clientes por su lado',
	'El cierre del día se hace de memoria',
];

const despues = [
	'Cada persona que escribe queda registrada, con su historia',
	'Citas y ventas en un solo lugar, desde cualquier celular',
	'Los avisos de cita salen solos, sin pagar por aviso enviado',
	'Tu equipo ve lo que le toca, y tú ves todo',
	'Lo que entró hoy, en una pantalla',
];

const pasos = [
	{
		id: 'registro',
		etiqueta: 'Escriben',
		title: 'Te escriben y quedan registrados solos',
		body: 'Los mensajes al WhatsApp del negocio llegan a una sola bandeja. Quien escribe queda con su ficha, su teléfono y su historia, sin que nadie copie datos a ninguna parte.',
		componente: 'whatsapp',
	},
	{
		id: 'agenda',
		etiqueta: 'Agendan',
		title: 'La cita entra a la agenda sin que la pases a mano',
		body: 'Desde el chat o desde tu enlace de reservas, la cita cae en la agenda de quien la atiende. Cada quien ve su día y nadie pisa la hora de otro.',
		componente: 'agenda',
	},
	{
		id: 'avisos',
		etiqueta: 'Recuerdan',
		title: 'Nadie olvida a qué hora era',
		body: 'Al agendar, el aviso sale solo por WhatsApp y el cliente confirma con un toque. Menos horas perdidas por olvidos, y sin cobro por cada mensaje enviado.',
		componente: 'recordatorio',
	},
	{
		id: 'cobro',
		etiqueta: 'Pagan',
		title: 'Cobras sin cambiar de aplicación',
		body: 'Servicios y productos en la misma venta, con el medio de pago que use cada quien. La venta queda en la historia del cliente y en las cuentas del día.',
		componente: 'cobro',
	},
	{
		id: 'ventas',
		etiqueta: 'Cuadran',
		title: 'El día cuadra solo, venta por venta',
		body: 'Cada cobro queda en el listado con quién atendió, qué se vendió y si quedó pagado o abonado. Los gastos van en la misma lista, así que el total del día sale sin sacar cuentas.',
		componente: 'ventas',
	},
	{
		id: 'vuelven',
		etiqueta: 'Vuelven',
		title: 'Sabes quién dejó de venir, a tiempo',
		body: 'Vyva mira cada cuánto viene cada cliente y arma la lista de los que se pasaron de su ritmo. Desde ahí mismo se les escribe por WhatsApp.',
		componente: 'clientes',
	},
];

const incluye = [
	{
		icon: 'chat',
		title: 'Todo lo que te escriben, en un solo hilo',
		body: 'El WhatsApp del negocio con la historia de cada cliente al lado. Lo puede atender tu equipo sin pasarse el celular.',
	},
	{
		icon: 'calendar-dots',
		title: 'Tu enlace para reservar',
		body: 'Una página con tus servicios y tus horarios. Reservan a las once de la noche sin escribirte.',
	},
	{
		icon: 'bell-ringing',
		title: 'Avisos que salen solos',
		body: 'Confirmación y recordatorio de cada cita, y aviso a quien la atiende. No se cobra por aviso enviado.',
	},
	{
		icon: 'storefront',
		title: 'Cobrar y cerrar el día',
		body: 'Servicios, productos y varios medios de pago en la misma venta, con el cierre hecho al final del día.',
	},
	{
		icon: 'users',
		title: 'La historia de cada cliente',
		body: 'Qué se le hizo, cuándo vino, qué compró y cada cuánto vuelve. Deja de vivir en la memoria de quien lo atiende.',
	},
	{
		icon: 'sparkle',
		title: 'Escribirle a la lista que elijas',
		body: 'Una promoción, un cumpleaños o un «hace tres meses no vienes», a las personas que elijas, desde el mismo lugar.',
	},
	{
		icon: 'users-three',
		title: 'Tu equipo, con lo que le toca',
		body: 'Horarios y permisos por persona, y cuánto produce cada quien sin tener que preguntarlo.',
	},
	{
		icon: 'chart-line',
		title: 'Las cuentas hechas',
		body: 'Lo facturado, los clientes atendidos, los que vuelven y cómo va cada persona del equipo.',
	},
];

const paraQuienSi = [
	'Negocios que atienden a mucha gente con un equipo pequeño',
	'Los que reciben citas: estética, salud, bienestar, mascotas, servicios a domicilio',
	'Los que reciben pedidos por WhatsApp o por redes y los despachan cada día',
	'Los que ya no dan abasto respondiendo, agendando y cobrando a la vez',
];

const paraQuienNo = [
	'Si atiendes dos o tres personas al día, todavía no te compensa',
	'Si no tienes tarjeta débito o crédito para el pago mensual',
	'Si necesitas facturación electrónica ante la DIAN desde el primer día',
];
---

<Landing
	title="Vyva | La aplicación para negocios que atienden a mucha gente"
	description="Vyva reúne en un solo lugar lo que te escriben, las citas, el cobro, las ventas y las cuentas del día. Para negocios que atienden a mucha gente con poco equipo."
>
	<Nav checkout={CHECKOUT} client:load />

	<main>
		<!-- ============ HERO ============ -->
		<section class="relative overflow-hidden">
			<div
				class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_60%_at_85%_10%,var(--color-brand-100),transparent_60%)]"
			>
			</div>
			<div
				class="mx-auto grid max-w-7xl items-center gap-12 px-5 pt-16 pb-20 sm:px-8 lg:grid-cols-2 lg:gap-8 lg:pt-24 lg:pb-28"
			>
				<div>
					<p
						data-reveal
						class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-sm font-semibold text-brand-700"
					>
						<Icon name="sparkle" size={16} />
						Plan fundador · precio congelado
					</p>

					<h1
						data-reveal
						class="mt-6 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl lg:text-6xl"
					>
						Te llegan muchos clientes.
						<span class="text-brand-600">Que no se te caiga ninguno.</span>
					</h1>

					<p data-reveal class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">
						Cuando el día se llena, lo que falla no es el trabajo: es acordarse.
						Quién escribió, quién viene mañana, qué pedido falta, quién quedó
						debiendo y quién no ha vuelto. Vyva lo sostiene por ti, en un solo
						lugar.
					</p>

					<div data-reveal class="mt-8 flex flex-col gap-3 sm:flex-row">
						<a
							href={CHECKOUT}
							data-signup-plan={CHECKOUT}
							class="btn-press inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25"
						>
							Empieza ahora
							<Icon name="arrow-right" size={18} />
						</a>
						<a
							href="#como-funciona"
							class="btn-press inline-flex items-center justify-center rounded-xl border border-slate-300 px-6 py-3.5 text-base font-semibold text-slate-700 hover:border-slate-400"
						>
							Ver cómo funciona
						</a>
					</div>

					<p data-reveal class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-slate-500">
						<span class="inline-flex items-center gap-1.5">
							<Icon name="check" size={16} class="text-brand-600" /> Sin instalar nada
						</span>
						<span class="inline-flex items-center gap-1.5">
							<Icon name="check" size={16} class="text-brand-600" /> Configuración incluida
						</span>
						<span class="inline-flex items-center gap-1.5">
							<Icon name="check" size={16} class="text-brand-600" /> Sin permanencia
						</span>
					</p>
				</div>

				<div data-reveal class="relative">
					<MockWhatsapp
						pie="Lo que te escriben al WhatsApp del negocio, con la ficha del cliente hecha sola."
					/>
				</div>
			</div>
		</section>

		<!-- ============ DIFERENCIAL ============ -->
		<section class="border-y border-slate-200 bg-slate-50">
			<div class="mx-auto max-w-4xl px-5 py-12 text-center sm:px-8">
				<p data-reveal class="text-lg leading-relaxed text-slate-700">
					<strong class="text-ink">
						Cada negocio llega por una necesidad distinta.
					</strong>
					A uno le pesa agendar, a otro le pesan los pedidos del chat, a otro cobrar
					y cerrar caja, y a otro que la gente vuelva. Vyva resuelve la que te pese
					a ti, y las demás ya están ahí cuando te hagan falta.
				</p>
			</div>
		</section>

		<!-- ============ ANTES / DESPUÉS ============ -->
		<section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
			<div class="max-w-2xl">
				<h2 data-reveal class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
					El problema no es que falte trabajo. Es que el negocio vive en cinco
					lugares al tiempo.
				</h2>
			</div>

			<div class="mt-14 grid gap-6 lg:grid-cols-2">
				<div data-reveal class="rounded-2xl border border-slate-200 bg-white p-7">
					<h3 class="text-sm font-semibold tracking-[0.18em] text-slate-400 uppercase">
						Como está hoy
					</h3>
					<ul class="mt-6 space-y-4">
						{
							antes.map((a) => (
								<li class="flex gap-3 text-slate-600">
									<span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-slate-100 text-slate-400">
										<Icon name="x" size={12} />
									</span>
									<span class="text-sm leading-relaxed">{a}</span>
								</li>
							))
						}
					</ul>
				</div>

				<div data-reveal class="rounded-2xl border-2 border-brand-200 bg-brand-50/40 p-7">
					<h3 class="text-sm font-semibold tracking-[0.18em] text-brand-600 uppercase">
						Con Vyva
					</h3>
					<ul class="mt-6 space-y-4">
						{
							despues.map((d) => (
								<li class="flex gap-3 text-slate-700">
									<span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-600 text-white">
										<Icon name="check" size={12} />
									</span>
									<span class="text-sm leading-relaxed font-medium">{d}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<!-- ============ CÓMO FUNCIONA ============ -->
		<section id="como-funciona" class="bg-slate-50">
			<div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
				<div class="max-w-2xl">
					<p data-reveal class="text-sm font-semibold tracking-[0.18em] text-brand-600 uppercase">
						Cómo funciona
					</p>
					<h2 data-reveal class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
						El día completo, paso a paso
					</h2>
					<p data-reveal class="mt-4 text-lg leading-relaxed text-slate-600">
						Así se ve Vyva por dentro en cada momento del día.
					</p>
				</div>

				<div class="mt-16 flex flex-col gap-16 lg:gap-24">
					{
						pasos.map((paso, i) => (
							<div
								data-reveal
								class={`grid items-center gap-8 lg:grid-cols-2 lg:gap-14 ${
									i % 2 === 1 ? 'lg:[&>div:first-child]:order-2' : ''
								}`}
							>
								<div>
									<span class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-xs font-bold tracking-[0.14em] text-brand-700 uppercase shadow-sm">
										<span class="grid h-5 w-5 place-items-center rounded-full bg-brand-600 text-[0.65rem] text-white">
											{i + 1}
										</span>
										{paso.etiqueta}
									</span>
									<h3 class="mt-4 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
										{paso.title}
									</h3>
									<p class="mt-3 max-w-lg text-base leading-relaxed text-slate-600">
										{paso.body}
									</p>
								</div>
								<div>
									{paso.componente === 'whatsapp' && <MockWhatsapp />}
									{paso.componente === 'agenda' && <MockAgenda />}
									{paso.componente === 'ventas' && <MockVentas />}
									{paso.componente === 'recordatorio' && <MockRecordatorio />}
									{paso.componente === 'cobro' && <MockCobro />}
									{paso.componente === 'clientes' && <MockClientes />}
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- ============ EL NEGOCIO EN UNA PANTALLA ============ -->
		<section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
			<div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
				<div>
					<h2 data-reveal class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
						Y al final, saber cómo va el negocio sin pedirle cuentas a nadie
					</h2>
					<p data-reveal class="mt-4 text-lg leading-relaxed text-slate-600">
						Cuánto entró, cuántas personas atendiste, cuántas volvieron y cómo va
						cada quien. Son las mismas citas y ventas del día, ya
						sumadas.
					</p>
					<p data-reveal class="mt-4 text-lg leading-relaxed text-slate-600">
						Sirve para lo que cuesta decidir a ojo: a quién reforzar, qué día
						sobra gente, qué servicio se vende solo y cuál hay que mover.
					</p>
				</div>
				<div data-reveal>
					<MockPanel />
				</div>
			</div>
		</section>

		<!-- ============ QUÉ INCLUYE ============ -->
		<section id="caracteristicas" class="bg-slate-50">
			<div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
				<div class="max-w-2xl">
					<h2 data-reveal class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
						Todo incluido. No hay módulos que se pagan aparte.
					</h2>
				</div>

				<div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{
						incluye.map((p) => (
							<article
								data-reveal
								class="group rounded-2xl border border-slate-200 bg-white p-6 transition-colors duration-300 hover:border-brand-300"
							>
								<span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-700">
									<Icon name={p.icon as any} size={26} />
								</span>
								<h3 class="mt-5 text-lg font-bold text-ink">{p.title}</h3>
								<p class="mt-2 text-sm leading-relaxed text-slate-600">{p.body}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- ============ PRECIO ============ -->
		<section id="precio" class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
			<div class="mx-auto max-w-2xl text-center">
				<h2 data-reveal class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
					Un solo precio, y está aquí
				</h2>
				<p data-reveal class="mt-4 text-lg leading-relaxed text-slate-600">
					Sin cotización, sin «depende de tu negocio», sin llamada para saber
					cuánto cuesta.
				</p>
			</div>

			<div
				data-reveal
				class="mx-auto mt-12 max-w-lg overflow-hidden rounded-3xl border-2 border-brand-300 bg-white shadow-xl shadow-brand-600/10"
			>
				<div class="bg-brand-600 px-6 py-3 text-center">
					<p class="text-sm font-bold tracking-[0.14em] text-white uppercase">
						Plan fundador
					</p>
				</div>

				<div class="px-8 py-10 text-center">
					<SelectorPrecio precio={PRECIO_PLAN} client:load />

					<ul class="mt-8 space-y-3 text-left">
						{
							[
								'Todo lo del plan gratis, con mucho más uso mensual',
								'El asistente de IA que contesta por WhatsApp',
								'Todo tu equipo, sin cobro por persona',
								'Configuración inicial hecha contigo',
								'Precio congelado mientras seas cliente',
								'Sin contrato ni permanencia',
								'Soporte por WhatsApp: te responde una persona',
							].map((f) => (
								<li class="flex gap-3">
									<span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-600 text-white">
										<Icon name="check" size={12} />
									</span>
									<span class="text-sm font-medium text-slate-700">{f}</span>
								</li>
							))
						}
					</ul>

					<a
						href={CHECKOUT}
						data-signup-plan={CHECKOUT}
						class="btn-press mt-9 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25"
					>
						Empieza ahora
						<Icon name="arrow-right" size={18} />
					</a>

					<p class="mt-6 flex items-center justify-center gap-2 text-xs text-slate-400">
						<Icon name="lock-key" size={14} />
						Pago con tarjeta débito o crédito Visa o Mastercard
					</p>
				</div>
			</div>

			<p data-reveal class="mx-auto mt-6 max-w-lg text-center text-sm text-slate-600">
				¿Prefieres empezar sin pagar? El plan gratis trae agenda, clientes, ventas y el
				chat de WhatsApp, con un uso mensual incluido de avisos, plantillas y campañas.
				<a href="/pricing" class="font-semibold text-brand-700 underline">Ver los dos planes</a>
			</p>
		</section>

		<!-- ============ PARA QUIÉN SÍ / NO ============ -->
		<section id="casos" class="bg-slate-50">
			<div class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
				<div class="max-w-2xl">
					<h2 data-reveal class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
						Vyva no es para todo el mundo
					</h2>
					<p data-reveal class="mt-4 text-lg leading-relaxed text-slate-600">
						Preferimos decírtelo aquí y no después de que pagues.
					</p>
				</div>

				<div class="mt-12 grid gap-6 lg:grid-cols-2">
					<div data-reveal class="rounded-2xl border-2 border-brand-200 bg-white p-7">
						<h3 class="text-lg font-bold text-ink">Sí es para ti</h3>
						<ul class="mt-5 space-y-3">
							{
								paraQuienSi.map((u) => (
									<li class="flex gap-3">
										<span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-600 text-white">
											<Icon name="check" size={12} />
										</span>
										<span class="text-sm leading-relaxed font-medium text-slate-700">{u}</span>
									</li>
								))
							}
						</ul>
					</div>

					<div data-reveal class="rounded-2xl border border-slate-200 bg-white p-7">
						<h3 class="text-lg font-bold text-ink">Todavía no es para ti</h3>
						<ul class="mt-5 space-y-3">
							{
								paraQuienNo.map((u) => (
									<li class="flex gap-3">
										<span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-slate-100 text-slate-400">
											<Icon name="x" size={12} />
										</span>
										<span class="text-sm leading-relaxed text-slate-600">{u}</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- ============ FAQ ============ -->
		<section class="mx-auto max-w-3xl px-5 py-20 sm:px-8 lg:py-28">
			<Faq items={faqs} titulo="Lo que todos preguntan" />
		</section>

		<!-- ============ CTA FINAL ============ -->
		<section class="px-5 py-24 sm:px-8">
			<div
				class="relative mx-auto max-w-7xl overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 to-brand-800 px-6 py-16 text-center sm:px-12 lg:py-20"
			>
				<div
					class="pointer-events-none absolute inset-0 bg-[radial-gradient(40%_50%_at_50%_0%,rgba(255,255,255,0.18),transparent)]"
				>
				</div>
				<h2
					data-reveal
					class="mx-auto max-w-2xl text-3xl font-bold tracking-tight text-white sm:text-4xl"
				>
					Empieza hoy y deja de sostenerlo todo en la cabeza
				</h2>
				<p data-reveal class="mx-auto mt-4 max-w-xl text-lg text-brand-100">
