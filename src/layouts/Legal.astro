---
import Landing from './Landing.astro';
import Nav from '../components/Nav.svelte';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	heading: string;
	updated: string;
}

const { title, description, heading, updated } = Astro.props;
---

<Landing title={title} description={description}>
	<Nav client:load />

	<main class="legal">
		<section class="page-hero">
			<div class="mx-auto max-w-3xl px-5 sm:px-8">
				<h1 class="text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
					{heading}
				</h1>
				<p class="mt-4 text-sm font-medium text-slate-500">
					Última actualización: {updated} · VyvaPOS, LLC
				</p>
			</div>
		</section>

		<article class="mx-auto max-w-3xl px-5 pb-24 sm:px-8">
			<slot />
		</article>
	</main>

	<Footer />
</Landing>

<style is:global>
	/* Documento legal: texto largo, jerarquía sobria y medida cómoda de lectura. */
	.legal article {
		color: #475569;
		font-size: 1rem;
		line-height: 1.75;
	}

	.legal article h2 {
		margin: 3rem 0 1rem;
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--color-ink);
	}

	.legal article h2:first-child {
		margin-top: 0;
	}

	.legal article h3 {
		margin: 2rem 0 0.75rem;
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--color-ink);
	}

	.legal article p {
		margin: 0 0 1rem;
	}

	.legal article ul {
		margin: 0 0 1.25rem;
		padding-left: 1.25rem;
		list-style: disc;
	}

	.legal article li {
		margin-bottom: 0.5rem;
	}

	.legal article strong {
		color: var(--color-ink);
		font-weight: 600;
	}

	.legal article a {
		color: var(--color-brand-700);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.legal article hr {
		margin: 3rem 0;
		border: 0;
		border-top: 1px solid #e2e8f0;
	}

	.legal article .destacado {
		margin: 1.5rem 0;
		border-left: 4px solid var(--color-brand-600);
		background: var(--color-brand-50);
		padding: 1rem 1.25rem;
		border-radius: 0 0.75rem 0.75rem 0;
	}

	.legal article .destacado p:last-child {
		margin-bottom: 0;
	}
</style>
