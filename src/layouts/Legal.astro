---
import Landing from './Landing.astro';
import Nav from '../components/Nav.svelte';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	heading: string;
	updated: string;
}

const { title, description, heading, updated } = Astro.props;
---

<Landing title={title} description={description}>
	<Nav client:load />

	<main>
		<section class="page-hero">
			<div class="mx-auto max-w-3xl px-5 sm:px-8">
				<h1 class="text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
					{heading}
				</h1>
				<p class="mt-4 text-sm font-medium text-slate-500">
					Última actualización: {updated} · VyvaPOS, LLC
				</p>
			</div>
		</section>

		<article class="prosa mx-auto max-w-3xl px-5 pb-24 sm:px-8">
			<slot />
		</article>
	</main>

	<Footer />
</Landing>
