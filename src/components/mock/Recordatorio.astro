---
/** El aviso automático que sale solo cuando se agenda una cita. */
import Marco from './Marco.astro';

interface Props {
  pie?: string;
  clase?: string;
}
const { pie, clase } = Astro.props;
---

<Marco titulo="Avisos automáticos" contexto="Sin escribir nada" pie={pie} clase={clase}>
  <div class="grid gap-3 @md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    <div class="min-w-0 rounded-2xl border border-slate-100 bg-white p-3 shadow-sm">
      <p class="text-[0.62rem] font-semibold tracking-wide text-slate-400 uppercase">Cuando pasa esto</p>
      <div class="mt-2 flex items-center gap-2.5 rounded-xl bg-[#f3f4f7] px-3 py-2.5">
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-xl bg-brand-500 text-white">
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="18" height="17" rx="3" />
            <path d="M8 2v4M16 2v4M3 10h18" />
          </svg>
        </span>
        <p class="text-[0.78rem] font-semibold text-ink">Se agenda una cita</p>
      </div>

      <p class="mt-3 text-[0.62rem] font-semibold tracking-wide text-slate-400 uppercase">Vyva hace esto</p>
      <div class="mt-2 flex flex-col gap-2">
        <div class="flex items-center gap-2.5 rounded-xl border border-slate-100 px-3 py-2">
          <span class="h-2 w-2 shrink-0 rounded-full bg-[#61b197]"></span>
          <p class="text-[0.75rem] text-slate-600">Le confirma al cliente por WhatsApp</p>
        </div>
        <div class="flex items-center gap-2.5 rounded-xl border border-slate-100 px-3 py-2">
          <span class="h-2 w-2 shrink-0 rounded-full bg-[#61b197]"></span>
          <p class="text-[0.75rem] text-slate-600">Le recuerda antes de la cita</p>
        </div>
        <div class="flex items-center gap-2.5 rounded-xl border border-slate-100 px-3 py-2">
          <span class="h-2 w-2 shrink-0 rounded-full bg-[#61b197]"></span>
          <p class="text-[0.75rem] text-slate-600">Avisa al profesional que le toca</p>
        </div>
      </div>
    </div>

    <div class="flex min-w-0 flex-col rounded-2xl border border-slate-100 bg-white p-3 shadow-sm">
      <p class="text-[0.62rem] font-semibold tracking-wide text-slate-400 uppercase">Lo que recibe el cliente</p>
      <div class="mt-2 rounded-2xl bg-[#e6f7e6]/60 p-3">
        <p class="rounded-2xl rounded-bl-md bg-white px-3 py-2.5 text-[0.78rem] leading-relaxed text-slate-700 shadow-sm">
          Hola María Camila 👋 Tu cita en <span class="font-semibold">Studio Bella</span> quedó para el
          <span class="font-semibold">viernes 26 a las 3:00 pm</span>. ¡Te esperamos!
        </p>
        <div class="mt-2 flex flex-col gap-1.5">
          <span class="rounded-xl bg-white px-3 py-2 text-center text-[0.74rem] font-semibold text-[#2f7c65] shadow-sm">
            Sí, ahí estaré
          </span>
          <span class="rounded-xl bg-white px-3 py-2 text-center text-[0.74rem] font-semibold text-[#2f7c65] shadow-sm">
            Reprogramar la cita
          </span>
        </div>
      </div>
      <p class="mt-auto pt-3 text-[0.7rem] leading-snug text-slate-500">
        Si responde «Sí, ahí estaré», la cita queda confirmada en la agenda sola.
      </p>
    </div>
  </div>
</Marco>
