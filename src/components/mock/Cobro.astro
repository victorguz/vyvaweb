---
/** El cobro: servicios y productos en la misma venta, con el medio de pago. */
import Marco from './Marco.astro';

interface Props {
  pie?: string;
  clase?: string;
}
const { pie, clase } = Astro.props;

const lineas = [
  { que: 'Limpieza facial profunda', detalle: 'Servicio · Daniela', valor: '$120.000' },
  { que: 'Sérum vitamina C', detalle: 'Producto · 1 unidad', valor: '$68.000' },
];
---

<Marco titulo="Venta" contexto="Camila Rojas" pie={pie} clase={clase}>
  <div class="grid gap-3 @md:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
    <div class="min-w-0 rounded-2xl border border-slate-100 bg-white p-3 shadow-sm">
      {
        lineas.map((linea) => (
          <div class="flex items-start gap-3 border-b border-slate-50 py-2.5 last:border-0">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 2 3 6v14h18V6l-3-4z" />
                <path d="M3 6h18" />
                <path d="M16 10a4 4 0 0 1-8 0" />
              </svg>
            </span>
            <div class="min-w-0">
              <p class="truncate text-[0.82rem] font-semibold text-ink">{linea.que}</p>
              <p class="truncate text-[0.7rem] text-slate-500">{linea.detalle}</p>
            </div>
            <span class="ml-auto shrink-0 text-[0.82rem] font-semibold text-ink">{linea.valor}</span>
          </div>
        ))
      }
      <div class="mt-2 flex items-center justify-between rounded-xl bg-[#f3f4f7] px-3 py-2.5">
        <span class="text-[0.75rem] font-medium text-slate-600">Total</span>
        <span class="text-lg font-bold text-ink">$188.000</span>
      </div>
    </div>

    <div class="flex min-w-0 flex-col gap-2.5 rounded-2xl border border-slate-100 bg-white p-3 shadow-sm">
      <p class="text-[0.68rem] font-semibold tracking-wide text-slate-400 uppercase">Medio de pago</p>
      <div class="flex items-center gap-2 rounded-xl border-2 border-brand-400 bg-brand-50 px-3 py-2">
        <span class="grid h-7 w-7 place-items-center rounded-lg bg-brand-500 text-white">
          <svg
            class="h-3.5 w-3.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </span>
        <span class="text-[0.8rem] font-semibold text-ink">Efectivo</span>
      </div>
      <div class="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2">
        <span class="h-7 w-7 rounded-lg bg-slate-100"></span>
        <span class="text-[0.8rem] text-slate-600">Tarjeta</span>
      </div>
      <div class="flex items-center gap-2 rounded-xl border border-slate-200 px-3 py-2">
        <span class="h-7 w-7 rounded-lg bg-slate-100"></span>
        <span class="text-[0.8rem] text-slate-600">Transferencia</span>
      </div>
      <button
        type="button"
        tabindex="-1"
        aria-hidden="true"
        class="mt-auto w-full rounded-xl bg-brand-600 px-4 py-2.5 text-[0.85rem] font-semibold text-white shadow-lg shadow-brand-600/25"
      >
        Cobrar $188.000
      </button>
    </div>
  </div>
</Marco>
