---
/** Un cliente escribe al WhatsApp del negocio y queda registrado solo. */
import Marco from './Marco.astro';

interface Props {
  pie?: string;
  clase?: string;
}
const { pie, clase } = Astro.props;
---

<Marco titulo="Conversaciones" contexto="WhatsApp del negocio" pie={pie} clase={clase}>
  <div class="grid gap-3 @md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
    <!-- Lista de conversaciones -->
    <div class="min-w-0 rounded-2xl border border-slate-100 bg-white p-2.5 shadow-sm">
      <div class="flex items-center gap-2 rounded-xl bg-brand-50 p-2.5">
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-brand-500 text-xs font-semibold text-white">
          MC
        </span>
        <div class="min-w-0">
          <p class="truncate text-[0.8rem] font-semibold text-ink">María Camila</p>
          <p class="truncate text-[0.72rem] text-slate-500">¿Tienes cupo el viernes?</p>
        </div>
        <span class="ml-auto grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-600 text-[0.65rem] font-bold text-white">
          2
        </span>
      </div>
      <div class="flex items-center gap-2 p-2.5">
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-slate-200 text-xs font-semibold text-slate-600">
          JD
        </span>
        <div class="min-w-0">
          <p class="truncate text-[0.8rem] font-semibold text-ink">Juan David</p>
          <p class="truncate text-[0.72rem] text-slate-500">Listo, quedo atento</p>
        </div>
      </div>
      <div class="flex items-center gap-2 p-2.5">
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-slate-200 text-xs font-semibold text-slate-600">
          LG
        </span>
        <div class="min-w-0">
          <p class="truncate text-[0.8rem] font-semibold text-ink">Laura G.</p>
          <p class="truncate text-[0.72rem] text-slate-500">Gracias 🙌</p>
        </div>
      </div>
    </div>

    <!-- Conversación -->
    <div class="flex min-w-0 flex-col rounded-2xl border border-slate-100 bg-white p-3 shadow-sm">
      <div class="flex items-center gap-2 border-b border-slate-100 pb-2.5">
        <span class="grid h-8 w-8 place-items-center rounded-full bg-brand-500 text-[0.7rem] font-semibold text-white">
          MC
        </span>
        <div>
          <p class="text-[0.8rem] font-semibold text-ink">María Camila</p>
          <p class="text-[0.7rem] text-slate-500">+57 300 ••• 41 22</p>
        </div>
        <span class="ml-auto rounded-full bg-[#61b197]/15 px-2 py-1 text-[0.65rem] font-semibold text-[#3d8a72]">
          Cliente nuevo
        </span>
      </div>

      <div class="flex flex-col gap-2 py-3">
        <p class="max-w-[85%] self-start rounded-2xl rounded-bl-md bg-slate-100 px-3 py-2 text-[0.78rem] text-slate-700">
          Hola, ¿tienes cupo el viernes en la tarde?
        </p>
        <p class="max-w-[85%] self-end rounded-2xl rounded-br-md bg-brand-500 px-3 py-2 text-[0.78rem] text-white">
          ¡Claro! Te dejo el viernes a las 3:00 p. m. ¿Te sirve?
        </p>
        <p class="max-w-[85%] self-start rounded-2xl rounded-bl-md bg-slate-100 px-3 py-2 text-[0.78rem] text-slate-700">
          Perfecto, muchas gracias
        </p>
      </div>

      <div class="mt-auto flex items-center gap-2 rounded-xl bg-[#f3f4f7] px-3 py-2.5">
        <svg
          class="h-4 w-4 shrink-0 text-[#61b197]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
        <p class="text-[0.72rem] leading-snug text-slate-600">
          <span class="font-semibold text-ink">Ficha creada:</span> María Camila quedó en tus clientes, con su teléfono y esta conversación.
        </p>
      </div>
    </div>
  </div>
</Marco>
